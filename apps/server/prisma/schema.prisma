// 零代码活动页平台数据模型
// 设计原则：发布产物不可变（ActivityVersion 快照），草稿可覆盖（DslDraft 单行）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- RBAC ----------

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String? // SSO 用户为空
  nickname  String
  avatar    String?
  email     String?
  ssoId     String?  @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles      UserRole[]
  activities Activity[] @relation("ActivityOwner")
  memberOf   ActivityMember[]

  @@map("user")
}

model Role {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  remark    String?
  createdAt DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id     String  @id @default(cuid())
  code   String  @unique // 与 @nca/shared 的 PERMISSION 字典一致
  name   String
  module String?

  roles RolePermission[]

  @@map("permission")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

/// C 端用户：活动页上的参与者，与后台的 User 是两套身份，互不相通。
/// 同一个人从不同来源登录（SSO / 小程序 / 某个宿主）是不同的行——各来源的
/// 用户 id 不在一个命名空间里，强行合并只会把两个人认成一个人。
model RuntimeUser {
  id          String   @id @default(cuid())
  /// 身份来源：sso / wechat_mp / 宿主类型（sdk_portrait、game_center…）
  provider    String   @db.VarChar(32)
  /// 来源系统里的用户 id（OIDC 的 sub、小程序的 openid/unionid、宿主账号 id）
  externalId  String   @db.VarChar(128)
  nickname    String?
  avatar      String?  @db.VarChar(1024)
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())

  @@unique([provider, externalId])
  @@map("runtime_user")
}

// ---------- 活动 ----------

enum ActivityStatus {
  draft
  published
  offline
}

model Activity {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  cover       String?
  status      ActivityStatus @default(draft)
  startTime   DateTime?
  endTime     DateTime?

  /// 当前线上版本号，指向 ActivityVersion.version；回滚只改这个指针
  publishedVersion Int?

  ownerId String
  owner   User   @relation("ActivityOwner", fields: [ownerId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  draft       DslDraft?
  members     ActivityMember[]
  versions    ActivityVersion[]
  assets      Asset[]
  prizes      Prize[]
  channels    Channel[]
  submissions FormSubmission[]
  aiRuns      AiRun[]

  @@index([status, updatedAt])
  @@index([ownerId])
  @@map("activity")
}

/// 活动协作成员。负责人另记在 activity.ownerId；没有 activity:all 数据范围的用户
/// 只能看到自己负责或被拉进来的活动。
model ActivityMember {
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// editor 可编辑 / viewer 只读
  role       String   @default("editor") @db.VarChar(16)
  addedBy    String?
  createdAt  DateTime @default(now())

  @@id([activityId, userId])
  @@index([userId])
  @@map("activity_member")
}

/// 草稿：单活动单行，自动保存直接覆盖
model DslDraft {
  activityId String   @id
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  dsl        Json
  updatedBy  String?
  updatedAt  DateTime @updatedAt

  @@map("dsl_draft")
}

/// 发布快照：一经写入不再修改，是回滚与审计的依据
model ActivityVersion {
  id          String   @id @default(cuid())
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  version     Int
  dsl         Json
  dslUrl      String?
  manifestUrl String?
  changelog   String?  @db.Text
  createdBy   String?
  createdAt   DateTime @default(now())

  @@unique([activityId, version])
  @@index([activityId, createdAt])
  @@map("activity_version")
}

// ---------- 模板与物料 ----------

model Template {
  id          String   @id @default(cuid())
  title       String
  cover       String?
  description String?  @db.Text
  category    String?
  dsl         Json
  favCount    Int      @default(0)
  useCount    Int      @default(0)
  enabled     Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites TemplateFavorite[]

  @@index([category, enabled])
  @@map("template")
}

/// 收藏是「谁收藏了哪个模板」，光靠 template.favCount 判断不出当前用户收没收藏
model TemplateFavorite {
  userId     String
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, templateId])
  @@index([userId])
  @@map("template_favorite")
}

/// 物料注册表。代码里的 materials 包是实现，这里存可用性与灰度开关
model Material {
  name      String   @id
  version   String
  title     String
  category  String
  meta      Json
  enabled   Boolean  @default(true)
  sort      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("material")
}

// ---------- 资源 ----------

model Asset {
  id         String    @id @default(cuid())
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  url        String    @db.VarChar(1024)
  type       String
  size       Int       @default(0)
  hash       String?
  width      Int?
  height     Int?
  uploadedBy String?
  createdAt  DateTime  @default(now())

  @@index([activityId])
  @@index([hash])
  @@map("asset")
}

// ---------- 业务能力 ----------

model Prize {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name         String
  image        String?
  /// 万分比，10000 表示 100%
  probability  Int      @default(0)
  total        Int      @default(0)
  remaining    Int      @default(0)
  /// 单用户可中奖上限，0 不限
  limitPerUser Int      @default(0)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())

  records PrizeRecord[]

  @@index([activityId])
  @@map("prize")
}

model PrizeRecord {
  id         String   @id @default(cuid())
  activityId String
  prizeId    String
  prize      Prize    @relation(fields: [prizeId], references: [id])
  userId     String
  status     String   @default("won") // won / shipped / expired
  createdAt  DateTime @default(now())

  @@index([activityId, userId])
  @@index([prizeId])
  @@map("prize_record")
}

model FormSubmission {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  formNodeId String
  userId     String?
  data       Json
  ip         String?
  createdAt  DateTime @default(now())

  @@index([activityId, createdAt])
  @@map("form_submission")
}

model Channel {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  code       String
  /// 渠道透传参数，落地页 query 上下文可取
  params     Json?
  createdAt  DateTime @default(now())

  @@unique([activityId, code])
  @@map("channel")
}

model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  activityId String
  version    Int?
  nodeId     String?
  event      String // expose / click / convert
  userId     String?
  channel    String?
  host       String?
  props      Json?
  createdAt  DateTime @default(now())

  @@index([activityId, event, createdAt])
  @@map("analytics_event")
}

// ---------- AI Agent ----------

enum AiRunStatus {
  running
  interrupted
  succeeded
  failed
  cancelled
}

/// 一次 AI 会话 = 一个 run，它的 id 同时就是 LangGraph 的 thread_id。
/// 中断等待的是人的决策，可能几分钟也可能隔天，所以状态落 MySQL 而不是 Redis：
/// TTL 语义对不上，而且这张表顺带就是「谁在什么时候批准了什么」的审计账。
model AiRun {
  id         String      @id @default(cuid())
  activityId String?
  activity   Activity?   @relation(fields: [activityId], references: [id], onDelete: SetNull)
  /// 能力注册表里的场景 key，决定跑哪张图
  scenario   String      @default("build") @db.VarChar(64)
  status     AiRunStatus @default(running)
  title      String?
  /// 当前挂起的中断点快照，null 表示没在等人
  interrupt  Json?
  error      String?     @db.Text
  createdBy  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  steps AiRunStep[]

  @@index([activityId, createdAt])
  @@index([createdBy, createdAt])
  @@map("ai_run")
}

/// 每个节点、每次人工决策各一条，一经写入不再修改。
/// 前端断线重连时靠它补齐前情，不必依赖 SSE 重放。
model AiRunStep {
  id        String   @id @default(cuid())
  runId     String
  run       AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  /// node | interrupt | resume | message | patch | error
  kind      String   @db.VarChar(32)
  node      String?  @db.VarChar(64)
  payload   Json
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, createdAt])
  @@map("ai_run_step")
}

/// LangGraph 检查点。官方只提供 SQLite / Postgres / Redis 三种实现，
/// 本项目是 MySQL，这两张表配合 PrismaCheckpointSaver 自己补上。
/// 字段名对齐官方实现，将来换成官方 MySQL 版时数据可平移。
model AiCheckpoint {
  threadId           String   @db.VarChar(64)
  checkpointNs       String   @default("") @db.VarChar(128)
  checkpointId       String   @db.VarChar(64)
  parentCheckpointId String?  @db.VarChar(64)
  /// serde 的类型标记，与 checkpoint / metadata 的字节流配套
  type               String?  @db.VarChar(32)
  checkpoint         Bytes
  metadata           Bytes
  createdAt          DateTime @default(now())

  @@id([threadId, checkpointNs, checkpointId])
  @@index([threadId, checkpointNs])
  @@map("ai_checkpoint")
}

/// 检查点之间的中间写入。idx 为负数的是 LangGraph 的保留通道
/// （error/scheduled/interrupt/resume），允许覆盖；非负的先到先得。
model AiCheckpointWrite {
  threadId     String  @db.VarChar(64)
  checkpointNs String  @default("") @db.VarChar(128)
  checkpointId String  @db.VarChar(64)
  taskId       String  @db.VarChar(64)
  idx          Int
  channel      String  @db.VarChar(128)
  type         String? @db.VarChar(32)
  value        Bytes

  @@id([threadId, checkpointNs, checkpointId, taskId, idx])
  @@index([threadId, checkpointNs, checkpointId])
  @@map("ai_checkpoint_write")
}

/**
 * 活动预约记录。一个用户对一个场次只能预约一次（@@unique 兜底并发），
 * 防止重复刷。capacity / 时段等配置后续按需扩展，v1 只做「预约上/已预约过」。
 */
model AppointmentRecord {
  id         String   @id @default(cuid())
  activityId String
  sceneId    String
  userId     String
  /// 预约时留的联系方式（手机号等），可选
  contact    String?
  status     String   @default("confirmed") // confirmed / cancelled
  createdAt  DateTime @default(now())

  @@unique([activityId, sceneId, userId])
  @@index([activityId, createdAt])
  @@map("appointment_record")
}

/**
 * 操作审计：后台「谁在何时对哪个资源做了什么」。由 @Audit 装饰器 + 全局
 * AuditInterceptor 在成功变更后自动落一条，detail 存请求体便于复盘。
 */
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  username   String?
  /// 语义动作，如 activity.publish / template.disable / prize.create
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}
