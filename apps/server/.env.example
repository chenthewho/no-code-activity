NODE_ENV=development
PORT=3100
API_PREFIX=api/v1

# MySQL 8。可用 docker-compose.yml 一键起
DATABASE_URL="mysql://root:root@localhost:3307/no_code_activity"

# 不配则锁降级为进程内实现，仅限单实例本地开发
REDIS_URL="redis://localhost:6381"

JWT_SECRET="dev-secret-change-me-in-production"
JWT_EXPIRES_IN=7d

CORS_ORIGINS="http://localhost:5173,http://localhost:5180"

# 对象存储。留空则发布产物写本地 PUBLISH_LOCAL_DIR 并由 /static 托管
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
CDN_BASE_URL="http://localhost:3100/static"
PUBLISH_LOCAL_DIR="./.publish"
# 活动页站点根：发布后返回的活动地址由它拼出（渲染器的地址，不是产物托管地址）
ACTIVITY_BASE_URL="http://localhost:5180"

# 服务端对外的 API 根地址（含前缀），SSO 回调地址由它拼出：<PUBLIC_API_BASE_URL>/sso/callback
PUBLIC_API_BASE_URL="http://localhost:3100/api/v1"
# 管理后台站点根，后台 SSO 登录完成后跳回 <ADMIN_BASE_URL>/login
ADMIN_BASE_URL="http://localhost:5173"

# 统一登录（OIDC 授权码 + PKCE）。none | oidc | mock（服务端自带模拟 IdP，仅限本地，生产禁用）
SSO_PROVIDER=mock
SSO_LABEL="统一登录"
# oidc 模式：配 issuer 走自动发现，或者显式给出三个端点
SSO_ISSUER=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPE="openid profile"
# userinfo 字段映射，按 IdP 实际命名调整
SSO_CLAIM_USER_ID=sub
SSO_CLAIM_USERNAME=preferred_username
SSO_CLAIM_NICKNAME=name
SSO_CLAIM_AVATAR=picture
# 后台是否允许 SSO 登录；首次登录自动开户并授予该角色
SSO_ADMIN_ENABLED=true
SSO_ADMIN_DEFAULT_ROLE=viewer

# C 端登录态。密钥留空则由 JWT_SECRET 派生（两种 token 互不通用）
RUNTIME_JWT_SECRET=
RUNTIME_JWT_EXPIRES_IN=30d
# 允许 SSO 登录后跳回的活动页源（逗号分隔），缺省只认 ACTIVITY_BASE_URL
RUNTIME_REDIRECT_ORIGINS=

# 宿主登录：none | http（POST {host, code} 到 HOST_AUTH_VERIFY_URL 换身份）| mock（接受 mock:<userId>，仅限本地）
HOST_AUTH_MODE=mock
HOST_AUTH_VERIFY_URL=
# 微信小程序 web-view：外层 wx.login 的 code 换活动页登录票据
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# Renderer 产物入口，写进 manifest.entry
RENDERER_ENTRY_JS="http://localhost:5180/dist/renderer.js"
RENDERER_ENTRY_CSS=""

# AI 助手。留空则 AI 接口报「未配置」，其余功能不受影响
ANTHROPIC_API_KEY=
# 走代理/网关时填，直连官方留空
ANTHROPIC_BASE_URL=
AI_MODEL="claude-opus-5"
AI_MAX_TOKENS=64000
AI_EFFORT=high
# adaptive | off。走网关/非 Claude 后端（如 deepseek）时用 off，否则 thinking+tool_choice 可能 400
AI_THINKING=adaptive
# force | auto。force=强制指定工具（Opus 5 原生）；走网关/非 Claude 后端时用 auto（模型不调工具会重试一次）
AI_TOOL_CHOICE=force
AI_MAX_PATCHES_PER_RUN=80
